{
  "name": "@hanzo/cal",
  "version": "0.1.0",
  "description": "Hanzo-owned booking components — Provider + Booker, a debranded fork surface of Cal.com's @calcom/atoms (MIT), pointed at the native Hanzo backend at api.hanzo.ai/v1/calendar.",
  "license": "MIT",
  "author": "Hanzo AI, Inc.",
  "homepage": "https://cal.hanzo.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/cal.git",
    "directory": "packages/cal"
  },
  "keywords": [
    "hanzo",
    "calendar",
    "booking",
    "scheduling",
    "booker",
    "react"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@calcom/atoms": "2.11.0",
    "dayjs": "1.11.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
